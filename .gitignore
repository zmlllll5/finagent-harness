# --- Build artifacts ---------------------------------------------------------
target/
build/
out/

# --- Build helpers (generated locally to work around maven colourised output) -
cp.txt
srcs.txt

# --- Local runtime state ------------------------------------------------------
# The harness caches SEC responses and per-user profiles under ~/.finagent/,
# so nothing here normally lands in the repo. These patterns cover people who
# override the paths to point inside the project.
.finagent/
eval-results/*.json
# ...but keep the sample exports, they are part of the write-up
!eval-results/sample-comparison.csv
!eval-results/sample-comparison.xlsx

# --- Secrets ------------------------------------------------------------------
.env
*.key
application-local.yml
application-local.properties

